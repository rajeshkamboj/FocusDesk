{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusDesk Focus Widget",
  "version": "0.1.0",
  "identifier": "com.focusdesk.focuswidget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "title": "FocusDesk — Focus",
        "width": 320,
        "height": 190,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Always-on-top companion showing the task FocusDesk is timing",
    "longDescription": "Experimental FocusDesk companion: a small, movable, always-on-top window that shows the active task and its elapsed time, and lets you pause, resume or finish it. It stores no task data — FocusDesk stays the source of truth.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
