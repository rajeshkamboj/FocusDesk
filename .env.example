# Supabase (optional — when empty, the app persists data in browser storage)
# Never commit real credentials. Only the public anon key belongs in frontend env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Focus Widget companion (experimental, optional — branch feature/windows-focus-widget)
# Loopback port the Windows companion listens on (default 8787).
NEXT_PUBLIC_FOCUS_WIDGET_PORT=8787
# Set to "false" to switch the companion link off without touching the code.
NEXT_PUBLIC_FOCUS_WIDGET_ENABLED=true
