# Supabase (optional — when empty, the app persists data in browser storage)
# Never commit real credentials. Only the public anon key belongs in frontend env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Curiosity content automation — all optional.
# Nothing here is required to run the app: with no variables set, the Curiosity tab
# publishes from the content pool in lib/curiosity/content/ into .curiosity/state.json,
# and Open Library is contacted only when a book is due. See
# docs/curiosity-content-automation.md for what each one changes.
#
# Never commit real credentials. Only the public publishable key belongs in a
# NEXT_PUBLIC_* variable; the keys below that omit that prefix are server-side only.

# Shared secret for the scheduler. The refresh endpoint answers only to a caller
# presenting this value, or to a signed-in user of the app. Left unset in
# production, the endpoint refuses every request and only the signed-in admin
# path works — which is a supported way to run, it just means no external cron.
#
# Listing it here documents the name; it does not create it. To use the shipped
# scheduler, set the same value in two places: the deployment's environment, and
# GitHub → Settings → Secrets and variables → Actions (with FOCUSDESK_URL), which is
# where .github/workflows/curiosity-daily.yml reads it.
CURIOSITY_CRON_SECRET=

# Where published days are kept. Empty = file at .curiosity/state.json; Supabase is
# used automatically once NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY both
# exist. Set to "file" to prefer the file even when a database is configured.
# Requires supabase/migrations/009_curiosity_content.sql to be applied.
CURIOSITY_STORE=
SUPABASE_SECRET_KEY=

# Path of the state file, when the working directory is not where you want it to
# persist (containers usually want a mounted volume here). Relative paths resolve
# against the process working directory.
CURIOSITY_STATE_FILE=

# Set to "off" to stop a page render from publishing a missed day. The schedule is
# then the only thing that writes; useful once a real cron is proven to be running.
CURIOSITY_AUTO_PUBLISH=

# Open Library's usage guidance asks for an identifying User-Agent with a contact
# address. Only used by the once-every-three-days book lookup.
OPENLIBRARY_CONTACT_EMAIL=
